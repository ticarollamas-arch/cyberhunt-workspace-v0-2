# Copie para /etc/cyberhunt-ai.env (chmod 600). Nunca commite o arquivo real.

# Token compartilhado SOMENTE entre a função serverless do Vercel e a VPS.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CHAI_API_TOKEN=

CHAI_DATA_DIR=/var/lib/cyberhunt-ai

# Servidor de modelos local
CHAI_PROVIDER=ollama
CHAI_OLLAMA_URL=http://127.0.0.1:11434
# CHAI_PROVIDER=llamacpp
# CHAI_LLAMACPP_URL=http://127.0.0.1:8080

# Modelos: defina DEPOIS de rodar scripts/benchmark_models.py.
CHAI_MODEL_GENERAL=qwen3:4b
CHAI_MODEL_CODE=
CHAI_MODEL_VISION=
CHAI_MODEL_EMBED=
CHAI_KEEP_ALIVE=5m
CHAI_NUM_CTX=8192
CHAI_TIMEOUT=300

# Verificação online de CVE/GHSA/commits/URLs (recomendado: 1)
CHAI_ONLINE_VERIFY=1
# Token GitHub somente leitura (opcional) para evitar limite de taxa ao verificar commits
CHAI_GITHUB_TOKEN=
CHAI_POLICY_MAX_AGE_DAYS=90
CHAI_CWE_CATALOG=/var/lib/cyberhunt-ai/cwe_catalog.json

# Voz e OCR locais (opcionais)
CHAI_WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
CHAI_WHISPER_MODEL=/opt/whisper.cpp/models/ggml-small.bin
CHAI_PIPER_BIN=/opt/piper/piper
CHAI_PIPER_VOICE=/opt/piper/voices/pt_BR-faber-medium.onnx
CHAI_FFMPEG_BIN=ffmpeg
CHAI_TESSERACT_BIN=tesseract

CHAI_MAX_UPLOAD=4000000
