# Caddy obtém TLS automaticamente. Troque o domínio pelo subdomínio da sua VPS.
ai.cyberhuntlab.com.br {
	# A API exige Bearer token; o proxy só repassa.
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:8765
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
